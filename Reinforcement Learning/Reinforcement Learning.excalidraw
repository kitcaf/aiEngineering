      "roundness": null,
      "seed": 506015265,
      "version": 116,
      "versionNonce": 1648943023,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785833621427,
      "link": null,
      "locked": false,
      "text": "用来更新当前策略的数据，是不是由当前策略或非常接近的策略产生的？",
      "fontSize": 24.799987792968743,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "用来更新当前策略的数据，是不是由当前策略或非常接近的策略产生的？",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
