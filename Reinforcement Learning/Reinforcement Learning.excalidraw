    },
    {
      "id": "YJ4xL5kgd5Asq3iyuGV4I",
      "type": "text",
      "x": 2565.64730164068,
      "y": 4484.739096492304,
      "width": 793.5996093749998,
      "height": 30.999984741210934,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
