      "isDeleted": false,
      "boundElements": null,
      "updated": 1787998354895,
      "link": null,
      "locked": false,
      "text": "cognition： rollout is expensive\n\n（1）collect data online\n（2）then process a small batch of data with\ncurrent policy\n（3）temporarily treat this batch as a small\ndataset\n（4）train for several epochs （N）\n（5）discard this dataset.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "cognition： rollout is expensive\n\n（1）collect data online\n（2）then process a small batch of data with current policy\n（3）temporarily treat this batch as a small dataset\n（4）train for several epochs （N）\n（5）discard this dataset.",
      "autoResize": false,
      "lineHeight": 1.25
    },
